# ============================================================
#  Opsentra Backend — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
# ============================================================

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ── MongoDB ───────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/opsentra
MONGODB_TEST_URI=mongodb://localhost:27017/opsentra_test

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Or use a full Redis URL (takes priority over host/port):
# REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_token_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── AWS ───────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=opsentra-assets
AWS_S3_SIGNED_URL_EXPIRES=3600

# ── AWS SES (Email) ───────────────────────────────────────
AWS_SES_FROM_EMAIL=noreply@opsentra.io
AWS_SES_FROM_NAME=Opsentra

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ── Bull (Redis Queue) ────────────────────────────────────
BULL_REDIS_HOST=127.0.0.1
BULL_REDIS_PORT=6379

# ── Bcrypt ────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Frontend URL (for email links) ────────────────────────
FRONTEND_URL=http://localhost:3000

# ── AI Log Analysis (optional) ────────────────────────────
# Get a free key at https://aistudio.google.com → "Get API Key"
# If not set, alert emails are still sent but without AI analysis.
GEMINI_API_KEY=your_gemini_api_key_here
# How long (seconds) before the next alert email is sent per workspace (default: 300 = 5 min)
ALERT_COOLDOWN_SECONDS=300
